{
  "name": "axis-base-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "gen:placeholders": "tsx scripts/gen-placeholders.ts",
    "build:functions": "tsx scripts/build-functions.ts",
    "parity": "tsx scripts/check-parity.ts",
    "check:functions": "npm run build:functions && deno check supabase/functions/game/index.ts",
    "deploy:functions": "npm run build:functions && supabase functions deploy game",
    "import:npcs": "tsx scripts/import-npc-sprites.ts",
    "lpc:setup": "tsx scripts/lpc/setup.ts",
    "lpc:build": "tsx scripts/lpc/build.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.3",
    "phaser": "^3.90.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.4",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
